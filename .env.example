APP_URL=http://localhost:3000
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-existing-project-id

# Account administration: sessions.write, users.read, users.write, teams.read, teams.write.
APPWRITE_API_KEY=your-server-api-key

AUTH_GOOGLE_ENABLED=false
AUTH_PAYPAL_ENABLED=false

# Onboarding data. Use a separate server key with rows.read, rows.write,
# files.read/files.write for document cleanup, and teams.read (the latter is needed by Trigger.dev's health task).
APPWRITE_DATABASE_ID=assentpay
APPWRITE_DATA_API_KEY=
# Optional schema-operator override; the existing broad server key is supported.
# Authenticated Appwrite CLI is also available via db:migrate -- --cli.
APPWRITE_SCHEMA_API_KEY=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: changing it makes stored integration credentials unreadable.
INTEGRATION_ENCRYPTION_KEY=

# Controlled deployments only, separate from Appwrite Google sign-in.
# With GMAIL_OAUTH_ENABLED=true, consent uses gmail.readonly + gmail.send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Use the existing connected review channel by default; no owner-email lookup.
# owner_dm is optional and additionally needs users:read.email and matching owner email.
SLACK_REVIEW_DESTINATION=channel

# PayPal sandbox REST app credentials are supplied by each workspace owner
# through the wizard, then encrypted in Appwrite. There is no live switch.

TRIGGER_PROJECT_REF=mojokinjjmybhdfgzxwaq
TRIGGER_SECRET_KEY=

# Private Appwrite Function. Keep execute permissions empty; invoke from server only.
APPWRITE_INTEGRATION_FUNCTION_ID=assentpay-integrations
# Optional versioned encryption keys. Existing v1 ciphertext keeps using the stable
# INTEGRATION_ENCRYPTION_KEY above. Never discard keys still referenced by rows/backups.
INTEGRATION_ENCRYPTION_KEY_ID=primary
# JSON map of named 64-hex keys, supplied as secret Function variables (never NEXT_PUBLIC).
INTEGRATION_ENCRYPTION_KEYS=

# Gmail push is optional; the private Function performs catch-up every 5 minutes.
# Topic must belong to the Google Cloud project that owns GMAIL_CLIENT_ID.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
GMAIL_PUSH_SUBSCRIPTION=
# Verify Slack Events API requests before accepting them.
SLACK_SIGNING_SECRET=
# JSON map: workspace ID -> that workspace's PayPal sandbox webhook ID.
PAYPAL_WEBHOOK_IDS_JSON=

# Public MVP: forwarding only. Leave OAuth off outside controlled testing.
GMAIL_OAUTH_ENABLED=false
# Vercel ingress + private worker: provider key is server-only.
RESEND_API_KEY=
# Verified receiving subdomain from Resend. Never point your main Gmail MX here.
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Exact HTTPS download hostnames observed in Resend attachment metadata.
# No wildcard, IP, port or redirect is permitted. Configure before importing files.
RESEND_ATTACHMENT_HOSTS=
# Verified operational sender; never the user's Gmail identity.
RESEND_FROM_EMAIL=
INBOUND_DAILY_LIMIT=200
# Private worker only. Explicit provider selection; never falls back to another vendor.
AI_PROVIDER=openai
# OpenRouter: set AI_PROVIDER=openrouter and select a model supporting strict
# structured outputs. Text and native PDF extraction work; scanned PDFs need review.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# json_schema is preferred. Use prompt_json for the selected free Nemotron model,
# which currently does not advertise native structured output support.
# Both modes still enforce the same strict schema and evidence checks in the app.
OPENROUTER_OUTPUT_MODE=json_schema
# Direct OpenAI: Responses API model supporting structured output.
OPENAI_API_KEY=
OPENAI_MODEL=
# Opt in to sending scanned PDFs to document vision. Human review remains required.
AI_DOCUMENT_VISION_ENABLED=false

# Dedicated local/Docker worker key; rows.read/write, users.read, teams.read, files.read/write.
APPWRITE_WORKER_API_KEY=

{
  "name": "assentpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:settings": "node --import tsx --test tests/settings.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:trigger": "node scripts/trigger-dev.mjs",
    "db:provision": "node --env-file=.env --import tsx scripts/migrate-appwrite.mts --cli",
    "db:plan": "node --import tsx scripts/migrate-appwrite.mts --offline",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate-appwrite.mts",
    "db:backfill": "node --env-file=.env --import tsx scripts/backfill-appwrite.mts",
    "db:cutover": "node --env-file=.env --import tsx scripts/storage-cutover.mts",
    "function:build": "node scripts/build-integration-function.mjs",
    "function:deploy": "node --env-file=.env --import tsx scripts/deploy-integration-function.mts",
    "db:backfill:inboxes": "node --env-file=.env --import tsx scripts/backfill-inboxes.mts",
    "worker:financial": "node --env-file=.env.worker --import tsx scripts/financial-worker.mts",
    "test:security": "node --import tsx --test tests/security.test.ts",
    "worker:inbox": "node --env-file=.env --import tsx scripts/financial-worker.mts --inbox-only",
    "worker:analysis": "node --env-file=.env --import tsx scripts/financial-worker.mts --analysis-only",
    "worker:triage": "node --env-file=.env --import tsx scripts/financial-worker.mts --triage-only",
    "test": "npm run test:security && npm run test:settings"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "2.5.0",
    "@trigger.dev/sdk": "^4.7.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fflate": "0.8.3",
    "jose": "^6.2.13",
    "next": "16.4.2",
    "node-appwrite": "^30.0.1",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "resend": "^6.34.1",
    "saxes": "6.0.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@trigger.dev/build": "^4.7.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  }
}
